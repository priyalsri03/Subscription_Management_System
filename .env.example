# Application Settings
PROJECT_NAME="Subscription Management System"
API_V1_STR="/api/v1"

# Database Configuration
# Local SQLite default; production can override with PostgreSQL DATABASE_URL
DATABASE_URL="sqlite:///./subscription_system.db"

# Security & JWT Configuration
SECRET_KEY="change-this-to-a-secure-secret-key-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
